# Local mode persists isolated practice workspaces in .data/clientdesk.sqlite.
# Hosted mode requires both Supabase variables; Vercel refuses local storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
FIREFLIES_API_KEY=
CALENDLY_API_KEY=

# Local-only Claude Code chat. Uses your signed-in plan, never an API fallback.
# Set to 1 only on your own machine; Vercel always disables this route.
CLIENTDESK_LOCAL_CHAT=0

# Optional hosted Claude chat. Keep the service token server-side.
CLIENTDESK_CHAT_URL=
CLIENTDESK_CHAT_TOKEN=
CLIENTDESK_APP_ORIGIN=
